# MandiMitra Environment Variables
# "Har Jagah, Har Waqt, Mandi in Pocket!"

# LLM Providers (LiteLLM / Gemini / OpenAI compatible)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_LLM_MODEL=gemini/gemini-2.0-flash

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_webhook
WHATSAPP_API_VERSION=v21.0

# App Settings
PORT=8000
DEBUG=True

